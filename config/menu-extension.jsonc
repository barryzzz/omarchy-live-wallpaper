{
  // Omarchy menu extension for live-wallpaper. Install script merges this
  // into ~/.config/omarchy/extensions/omarchy-menu.jsonc (JSONC concat is not
  // valid JSON, so this file is the single source of truth and install.sh
  // appends the whole object).

  "wallpaper": {
    "icon": "󰉏",
    "label": "壁纸",
    "description": "Live wallpaper rotation"
  },

  "wallpaper.switch": {
    "label": "立即切换",
    "action": "live-wallpaper next --force",
    "description": "Rotate now, ignoring the interval"
  },
  "wallpaper.next-local": {
    "label": "切换到本地壁纸",
    "action": "live-wallpaper next-local",
    "description": "Next image from the current theme"
  },
  "wallpaper.next-bing": {
    "label": "切换到 Bing 壁纸",
    "action": "live-wallpaper next-bing",
    "description": "Next Bing image"
  },

  "wallpaper.source": {
    "label": "图片来源"
  },
  "wallpaper.source.local": {
    "label": "仅本地主题",
    "action": "live-wallpaper config set source local",
    "checked": "[[ \"$(live-wallpaper config get source)\" == local ]]"
  },
  "wallpaper.source.bing": {
    "label": "仅 Bing 每日",
    "action": "live-wallpaper config set source bing",
    "checked": "[[ \"$(live-wallpaper config get source)\" == bing ]]"
  },
  "wallpaper.source.both": {
    "label": "两者交替",
    "action": "live-wallpaper config set source both",
    "checked": "[[ \"$(live-wallpaper config get source)\" == both ]]"
  },

  "wallpaper.interval": {
    "label": "切换间隔"
  },
  "wallpaper.interval.15m": {
    "label": "15 分钟",
    "action": "live-wallpaper config set interval_hours 0.25",
    "checked": "[[ \"$(live-wallpaper config get interval_hours)\" == 0.25 ]]",
    "description": "Effective minimum: the scheduler ticks every 15 minutes"
  },
  "wallpaper.interval.1h": {
    "label": "1 小时",
    "action": "live-wallpaper config set interval_hours 1",
    "checked": "[[ \"$(live-wallpaper config get interval_hours)\" == 1 ]]"
  },
  "wallpaper.interval.6h": {
    "label": "6 小时",
    "action": "live-wallpaper config set interval_hours 6",
    "checked": "[[ \"$(live-wallpaper config get interval_hours)\" == 6 ]]"
  },
  "wallpaper.interval.12h": {
    "label": "12 小时",
    "action": "live-wallpaper config set interval_hours 12",
    "checked": "[[ \"$(live-wallpaper config get interval_hours)\" == 12 ]]"
  },
  "wallpaper.interval.24h": {
    "label": "24 小时",
    "action": "live-wallpaper config set interval_hours 24",
    "checked": "[[ \"$(live-wallpaper config get interval_hours)\" == 24 ]]"
  },

  "wallpaper.notify": {
    "label": "切换通知",
    "action": "live-wallpaper config toggle notify",
    "checked": "[[ \"$(live-wallpaper config get notify)\" == true ]]",
    "description": "Show a notification on each switch"
  },

  "wallpaper.status": {
    "label": "当前状态",
    "action": "uwsm-app -- xdg-terminal-exec bash -lc 'live-wallpaper status; read -k 1'",
    "description": "Show status in a terminal"
  },
  "wallpaper.open-config": {
    "label": "编辑配置文件",
    "action": "xdg-open $HOME/.config/omarchy-live-wallpaper/config.toml"
  }
}
